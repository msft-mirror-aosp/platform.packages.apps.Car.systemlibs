package: "com.android.car.scalableui"
container: "system_ext"

flag {
    name: "enable_visual_data"
    namespace: "car_sys_exp"
    description: "This flag controls using VisiualData class to hold the properties."
    bug: "415493921"
}

flag {
    name: "enable_ext_panel_updates"
    namespace: "car_sys_exp"
    description: "This flag controls registering to PanelUpdates Consumer which allows Non-ScalableUIComponents to receive updates."
    bug: "418775156"
}

flag {
    name: "enable_decor"
    namespace: "car_sys_exp"
    description: "This flag controls enabling optional decor on task panel."
    bug: "415493921"
}

flag {
    name: "enable_animation_end_event"
    namespace: "car_sys_exp"
    description: "This flag controls dispatching events when panel animation ends."
    bug: "420700472"
}

flag {
    name: "scalable_ui_handle_configuration_change"
    namespace: "car_sys_exp"
    description: "This flag controls enabling scalable ui to handle configuration changes."
    bug: "438535832"
}

flag {
    name: "scalable_ui_applicable_displays"
    namespace: "car_sys_exp"
    description: "This flag controls filtering of events via applicable displays."
    bug: "439667783"
}