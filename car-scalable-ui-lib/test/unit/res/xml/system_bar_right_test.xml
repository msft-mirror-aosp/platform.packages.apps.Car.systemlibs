<SystemBar defaultVariant="@id/variant1" type="2" side="right" barZOrder="2">
    <Variant id="@+id/base">
        <Corner radius="10dp" />
        <Bounds girth="50" />
    </Variant>
    <Variant id="@+id/variant1" parent="@id/base">
        <Visibility isVisible="true"/>
        <Alpha alpha="0.8" />
    </Variant>

    <Variant id="@+id/variant2" parent="@id/base">
        <Visibility isVisible="false"/>
        <Alpha alpha="1.0" />
        <Insets left="0" top="0" right="20" bottom="30" />
    </Variant>

    <Transitions>
        <Transition onEvent="event1" toVariant="@id/variant1"/>
        <Transition onEvent="event1" toVariant="@id/variant2"/>
    </Transitions>
</SystemBar>
