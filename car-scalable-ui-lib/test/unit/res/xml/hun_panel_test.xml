<HunPanel defaultVariant="@id/variant2">
    <Variant id="@+id/base">
    </Variant>
    <Variant id="@+id/variant1" parent="@id/base">
        <Background drawable="@drawable/headsup_scrim" />
        <Visibility isVisible="true" />
        <Bounds left="0" top="10" width="1000" height="200" />
        <Gravity value="TOP" />
    </Variant>

    <Variant id="@+id/variant2" parent="@id/base">
        <Visibility isVisible="false" />
        <Bounds left="0" top="10" width="1000" height="200" />
        <Gravity value="TOP" />
    </Variant>

    <Transitions>
        <Transition onEvent="event1" toVariant="@id/variant1"/>
        <Transition onEvent="event2" toVariant="@id/variant2"/>
    </Transitions>
</HunPanel>
