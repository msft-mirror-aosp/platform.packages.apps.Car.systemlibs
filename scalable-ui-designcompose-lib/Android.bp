package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

android_library {
    name: "car-scalable-ui-designcompose-lib",
    srcs: [
        "src/**/*.java",
        "src/**/*.kt",
    ],
    optimize: {
        enabled: true,
    },
    static_libs: [
        "car-scalable-ui-lib",
        "designcompose-lib",
    ],
}

android_library_import {
    name: "designcompose-lib",
    aars: ["designcompose-0.33.0-debug.aar"],
    sdk_version: "current",
    static_libs: [
        "designcompose-common-lib",
        "designcompose-annotation-lib",
        "androidx.compose.foundation_foundation",
        "androidx.compose.runtime_runtime",
        "androidx.compose.ui_ui",
        "androidx.core_core",
        "androidx.activity_activity",
        "androidx.compose.material3_material3",
        "androidx.datastore_datastore",
        "androidx.lifecycle_lifecycle-runtime",
        "guava",
        "androidx.tracing_tracing",
        "androidx.compose.runtime_runtime",
        "libprotobuf-java-lite",
    ],
}

java_import {
    name: "designcompose-common-lib",
    jars: ["common-0.33.0.jar"],
    sdk_version: "current",
    static_libs: [
        "libprotobuf-java-lite",
        "javax_annotation-api_1.3.2",
    ],
}

java_import {
    name: "designcompose-annotation-lib",
    jars: ["annotation-0.33.0.jar"],
    sdk_version: "current",
    static_libs: [
    ],
}
