<config>
    <status id="0" type="inactive" proactiveMessage="Your internet plan has expired."
        reactiveMessage="%s can't connect to the internet." />
    <status id="1" type="trial"/>
    <status id="2" type="paid"/>
    <status id="3" type="expiring" useDate="true" proactiveMessage="Your internet plan expires by %s."
        reactiveMessage="%1$s needs internet. Plan ends by %2$s." />
    <status id="4" type="expiring" useDate="false" proactiveMessage="Your internet plan expires in %s days."
        reactiveMessage="%1$s needs internet. Plan ends in %2$s days." />
</config>
