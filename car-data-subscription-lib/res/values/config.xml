<resources>
    <!--The list of activities to exclude showing data subscription messages on launch -->
    <string-array translatable="false" name="config_dataSubscriptionBlockedActivitiesList">
    </string-array>

    <!--The list of packages to exclude showing data subscription messages on launch -->
    <string-array translatable="false" name="config_dataSubscriptionBlockedPackagesList">
        <item>com.android.car.settings</item>
        <item>com.android.car.carlauncher</item>
        <item>com.google.android.apps.maps</item>
    </string-array>

    <!-- The date and time format for data subscription controller, including expiration date -->
    <string name="config_dataSubscriptionDateTimeFormat" translatable="false">
        yyyy-MM-dd</string>
</resources>
